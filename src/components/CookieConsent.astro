---
// Souhlas s analytikou + GA4 (Google Analytics 4).
// Měřicí ID se bere z env proměnné PUBLIC_GA_ID (např. "G-XXXXXXXXXX").
// GA4 se načte teprve po odsouhlasení — bez souhlasu se nic netrackuje.
const gaId = import.meta.env.PUBLIC_GA_ID;
---

{gaId && (
  <>
    <section id="cookie-bar" class="cookie-bar" aria-labelledby="cookie-title" hidden>
      <div class="cookie-text">
        <strong id="cookie-title">Můžeme měřit návštěvnost?</strong>
        <p>
          S tvým souhlasem spustíme Google Analytics, abychom věděli, které
          recepty jsou užitečné. Bez souhlasu analytiku nenačteme. Odmítnutí
          nijak neomezí fungování webu.
        </p>
        <details>
          <summary>Podrobnosti o analytice</summary>
          <p>
            Google Analytics 4 zpracovává údaje o navštívených stránkách,
            přibližné poloze, zařízení a prohlížeči. Poskytovatelem je Google
            Ireland Limited; údaje mohou být zpracovány i v USA. Cookies
            <code>_ga</code> a <code>_ga_*</code> mohou zůstat až 2 roky.
            Naši volbu uložíme na 6 měsíců. Správcem webu je MVDr. Anežka
            Čmelíková, IČO 21779601 (Ranč Na Samotách). Více uvádí
            <a href="https://policies.google.com/privacy?hl=cs" target="_blank" rel="noopener">zásady Googlu</a>
            a <a href="https://nasamotach.cz/contactus" target="_blank" rel="noopener">kontakt na správce</a>.
          </p>
        </details>
      </div>
      <div class="cookie-actions">
        <button type="button" id="cookie-decline" class="cookie-btn cookie-btn--ghost">
          Odmítnout analytiku
        </button>
        <button type="button" id="cookie-accept" class="cookie-btn">
          Povolit analytiku
        </button>
      </div>
    </section>

    <script is:inline define:vars={{ gaId }}>
      (function () {
        var KEY = "cookie-consent-v2";
        var MAX_AGE = 183 * 24 * 60 * 60 * 1000;

        function loadGA() {
          if (window.__gaLoaded) return;
          window.__gaLoaded = true;

          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
          document.head.appendChild(s);

          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag("js", new Date());
          gtag("config", gaId, { anonymize_ip: true });
        }

        function hideBar() {
          var bar = document.getElementById("cookie-bar");
          if (bar) bar.hidden = true;
        }

        function showBar() {
          var bar = document.getElementById("cookie-bar");
          if (bar) bar.hidden = false;
        }

        function readConsent() {
          try {
            var stored = JSON.parse(localStorage.getItem(KEY));
            if (
              stored &&
              (stored.choice === "granted" || stored.choice === "denied") &&
              Date.now() - stored.createdAt < MAX_AGE
            ) {
              return stored.choice;
            }
            localStorage.removeItem(KEY);
          } catch (e) {}
          return null;
        }

        function saveConsent(choice) {
          try {
            localStorage.setItem(KEY, JSON.stringify({ choice: choice, createdAt: Date.now() }));
          } catch (e) {}
        }

        function removeAnalyticsCookies() {
          document.cookie.split(";").forEach(function (cookie) {
            var name = cookie.split("=")[0].trim();
            if (name === "_ga" || name.indexOf("_ga_") === 0) {
              document.cookie = name + "=; Max-Age=0; path=/; SameSite=Lax";
              document.cookie = name + "=; Max-Age=0; path=/; domain=." + location.hostname + "; SameSite=Lax";
            }
          });
        }

        function denyAnalytics() {
          saveConsent("denied");
          removeAnalyticsCookies();
          hideBar();
          if (window.__gaLoaded) location.reload();
        }

        var consent = readConsent();

        if (consent === "granted") {
          loadGA();
        } else if (consent === "denied") {
          // nic nenačítáme
        } else {
          showBar();
        }

        var accept = document.getElementById("cookie-accept");
        var decline = document.getElementById("cookie-decline");
        var settings = document.getElementById("cookie-settings");

        if (accept) {
          accept.addEventListener("click", function () {
            saveConsent("granted");
            hideBar();
            loadGA();
          });
        }

        if (decline) {
          decline.addEventListener("click", denyAnalytics);
        }

        if (settings) {
          settings.addEventListener("click", function () {
            showBar();
            var currentConsent = readConsent();
            if (currentConsent === "granted") {
              decline.textContent = "Odvolat souhlas";
            }
          });
        }
      })();
    </script>

    <style>
      .cookie-bar[hidden] {
        display: none;
      }
      .cookie-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1000;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.8rem 1.2rem;
        padding: 0.9rem 1.2rem;
        background: var(--accent-dark);
        color: #fff;
        box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.18);
        font-size: 0.9rem;
        line-height: 1.45;
      }
      .cookie-text {
        margin: 0;
        max-width: 720px;
        flex: 1 1 320px;
      }
      .cookie-text > p,
      .cookie-text details p {
        margin: 0.25rem 0 0;
      }
      .cookie-text summary {
        margin-top: 0.35rem;
        cursor: pointer;
        font-weight: 600;
      }
      .cookie-text a {
        color: #fff;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .cookie-text code {
        color: inherit;
      }
      .cookie-actions {
        display: flex;
        gap: 0.6rem;
        flex: 0 0 auto;
      }
      .cookie-btn {
        border: 1px solid #fff;
        background: var(--accent-3);
        color: #2b2117;
        font-weight: 600;
        padding: 0.45rem 1.1rem;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.9rem;
      }
      .cookie-btn:hover {
        filter: brightness(1.05);
      }
      .cookie-btn--ghost {
        background: transparent;
        color: #fff;
      }
      .cookie-btn--ghost:hover {
        background: rgba(255, 255, 255, 0.12);
      }
      @media (max-width: 560px) {
        .cookie-bar {
          flex-direction: column;
          align-items: stretch;
          text-align: center;
          gap: 0.6rem;
          padding: 0.7rem 0.9rem;
          font-size: 0.78rem;
          line-height: 1.35;
          max-height: 60vh;
          overflow-y: auto;
        }
        .cookie-text {
          flex: 0 0 auto;
        }
        .cookie-actions {
          justify-content: center;
        }
        .cookie-btn {
          padding: 0.4rem 0.9rem;
          font-size: 0.8rem;
        }
      }
    </style>
  </>
)}
